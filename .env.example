# ===========================================
# GRAM FIELD APP (Navadrishti-PWA) — ENV
# Installable Progressive Web App (no Capacitor / Play Store).
# Hosted separately from the main GRAM platform.
# Shares the same Supabase schema (users, csr_projects,
# csr_project_milestones, events, service_attendance_entries, …).
# Copy Supabase / Cloudinary / session secrets from the platform .env.
# ===========================================

# Application
NODE_ENV=development
APP_NAME=GRAM Field
# This PWA's own URL (separate host / port)
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Main GRAM web platform (separate host) — deep links only
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000

# Optional: call APIs through the platform gateway (/api/pwa/*)
# Leave empty to use this app's own /api/* routes (recommended for local PWA).
# NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:3000

# Supabase (same project as the main platform)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key

# Legacy aliases (optional)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Session (prefer same SESSION_SECRET / JWT_SECRET as platform for future SSO)
SESSION_SECRET=your_long_random_session_secret
SESSION_MAX_AGE=604800000

# Cloudinary (platform keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=navdrishti_uploads
CLOUDINARY_UPLOAD_FOLDER=navadrishti
