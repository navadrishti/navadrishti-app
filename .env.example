# ===========================================
# GRAM App (field PWA) — environment
# Same Supabase + Cloudinary project as the main platform.
# ===========================================

# This app's public URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Main GRAM platform (deep links only)
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000

# Supabase (same project as platform)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key

# Session (use the same secret as the platform when possible)
SESSION_SECRET=your_long_random_session_secret

# Cloudinary (same as platform)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
